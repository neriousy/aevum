{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aevum",
  "version": "0.1.7",
  "identifier": "io.github.neriousy.aevum",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aevum",
        "width": 1060,
        "height": 720,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": true
      },
      {
        "label": "indicator",
        "url": "index.html#/indicator",
        "title": "Aevum recording indicator",
        "width": 220,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Private, local voice-to-text",
    "longDescription": "Press and hold a global shortcut to transcribe your voice and paste the result into any Windows application.",
    "publisher": "Neriousy",
    "copyright": "Copyright © 2025 Kit Langton and © 2026 Neriousy contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "beb4ce81-36cf-5f73-a1a5-6c5f767677f3",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMEEyMjVERDI0NzRDMzkKUldRNVRFZlNYU0lLclI5ZUVDZWpnTlZidzhpMUJaUFE0aHl3Yi9vUlI5UWpuUXZFaHFmRzlneHkK",
      "endpoints": [
        "https://github.com/neriousy/aevum/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
